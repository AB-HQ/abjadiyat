rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function staffDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isStaff() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && staffDoc().data.active == true; }
    function isAdmin() { return isStaff() && staffDoc().data.role == 'admin'; }
    function canRecord() { return isStaff() && staffDoc().data.role in ['admin', 'teacher']; }

    function str(v, max) { return v is string && v.size() <= max; }
    function smallMap(v) { return v is map && v.size() <= 60; }
    function validStudent(d) {
      return d.keys().hasOnly(['name','grade','sec','teacher','updatedAt','mastered','tried','xp','streak','levels','passages','subs','harakat','lessons'])
        && str(d.name, 100) && str(d.grade, 20) && str(d.sec, 10) && str(d.teacher, 80)
        && d.updatedAt == request.time
        && d.mastered is number && d.tried is number && d.xp is number && d.streak is number && d.levels is number
        && smallMap(d.passages) && smallMap(d.subs) && smallMap(d.harakat) && smallMap(d.lessons);
    }

    // Staff accounts are created only by the admin from the dashboard.
    match /users/{uid} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if isAdmin();
    }
    // Teacher recordings: anyone may play them; admin and teachers may change them.
    match /overrides/{id} {
      allow read: if true;
      allow write: if canRecord();
    }
    // One small index of which texts have a teacher recording, so visitors
    // download only the recordings they actually play.
    match /meta/overrides {
      allow read: if true;
      allow write: if canRecord();
    }
    match /students/{sid} {
      allow read: if isStaff() || (signedIn() && sid.matches(request.auth.uid + '_.*'));
      allow create, update: if signedIn() && sid.matches(request.auth.uid + '_.*') && validStudent(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}
